# vLLM exposes an OpenAI-compatible endpoint. Replace these two values later.
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_MODEL=Qwen/Qwen3-8B
LLM_PROVIDER=vllm
LLM_API_KEY=EMPTY
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=180
LLM_MAX_TOKENS=2048
# vLLM: json_schema. Generic OpenAI-compatible fallback: prompt_json.
LLM_STRUCTURED_METHOD=json_schema

# Official ALQAC case-content service. Do not commit the real token.
ALQAC_API_URL=https://alqac-api.ngrok.pro/retrieve
ALQAC_API_KEY=
ALQAC_API_INTERVAL_SECONDS=5.1
ALQAC_API_TIMEOUT_SECONDS=30

# Retrieval / context budgets.
# ALQAC_QUERY_MODE=minimal: 2 order probes + 1 fact query (+1 relief query).
# ALQAC_QUERY_MODE=disposition: one order query only.
# ALQAC_QUERY_MODE=fact: one fact-style query only.
ALQAC_INITIAL_CASE_QUERIES=1
ALQAC_MAX_CASE_QUERIES=1
ALQAC_QUERY_MODE=fact
ALQAC_LAW_CANDIDATES=18
ALQAC_MAX_LAW_EVIDENCE=8
ALQAC_FEW_SHOTS=3
ALQAC_OUTCOME_KNN_K=7
ALQAC_DISPOSITION_CONFIDENCE=0.65
